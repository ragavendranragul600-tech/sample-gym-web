# IRONFORGE FITNESS - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your actual credentials

# Supabase Configuration
# Get these values from your Supabase project settings
# https://app.supabase.com/projects

# Your Supabase project URL
# Format: https://[project-id].supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase anonymous/public API key
# This key is safe to use in the browser (read-only, limited access)
# DO NOT use the service role key here
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Analytics (if using Google Analytics)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Environment
# development, staging, or production
VITE_ENV=development